TYPESAFE_API_KEY=your_typesafe_api_key_here
TYPESAFE_API_BASE=https://api.typesafe.ai

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL_LOW=gemini-2.5-flash-lite
GEMINI_MODEL_MEDIUM=gemini-2.5-flash
GEMINI_MODEL_HIGH=gemini-2.5-pro

GITHUB_TOKEN=your_github_token_here

# In production this falls back to SSM (/codereview/s3/pr-diffs-bucket-name, published by
# codereview-infra's s3.tf) when unset — set it locally to point at your own bucket/LocalStack.
DIFF_BUCKET=codereview-pr-diffs
